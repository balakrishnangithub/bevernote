{
  "name": "bevernote",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "A local-first, open-source note-taking application",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.cjs",
    "test": "vitest run",
    "test:core": "cargo test --workspace",
    "lint": "npm run lint:web && npm run lint:core",
    "lint:web": "eslint .",
    "lint:core": "cargo clippy --workspace --all-targets -- -D warnings",
    "format": "prettier --write src tests docs/**/*.md .github/**/*.yml scripts/**/*.{js,cjs,mjs} *.{js,cjs,mjs,json,ts,md} && cargo fmt --all",
    "format:check": "prettier --check src tests docs/**/*.md .github/**/*.yml scripts/**/*.{js,cjs,mjs} *.{js,cjs,mjs,json,ts,md} && cargo fmt --all --check",
    "android:init": "node scripts/tauri.cjs android init",
    "android:dev": "node scripts/tauri.cjs android dev",
    "android:build": "node scripts/tauri.cjs android build --apk"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tiptap/extension-color": "^3.32.2",
    "@tiptap/extension-font-family": "^3.32.2",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-paragraph": "^3.32.2",
    "@tiptap/extension-subscript": "^3.32.2",
    "@tiptap/extension-superscript": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-table-cell": "^3.32.2",
    "@tiptap/extension-table-header": "^3.32.2",
    "@tiptap/extension-table-row": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/extension-underline": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "lucide-react": "^1.67.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
